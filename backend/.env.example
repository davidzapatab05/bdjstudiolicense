DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bdj_license?schema=public"
JWT_SECRET="replace-with-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-32-plus-character-secret"
CORS_ORIGIN="https://license-console.example.com"
PORT=3000
NODE_ENV=development

# Required only for the first `npm run db:seed` against an empty database.
# Remove these values from the runtime environment after bootstrap.
BOOTSTRAP_SUPER_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_SUPER_ADMIN_PASSWORD="replace-with-a-unique-strong-password"
BOOTSTRAP_SUPER_ADMIN_NAME="BDJ Studio Administrator"
